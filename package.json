{
  "name": "orbitaevents-prova",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "sync:reviews": "node scripts/sync-reviews.mjs",
    "build": "npm run normalize:filenames && npm run rename:portfolio && npm run generate:portfolio && npm run sync:reviews && next build",
    "start": "next start",
    "lint": "next lint",
    "generate:portfolio": "node scripts/generate-portfolio-config.mjs",
    "rename:portfolio": "node scripts/rename-portfolio-images.mjs",
    "normalize:filenames": "node scripts/normalize-filenames.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "monitor": "npx ts-node scripts/monitor.ts",
    "health": "curl -s https://orbitaevents.com/api/health | node -e \"const d=require('fs').readFileSync(0,'utf8');const h=JSON.parse(d);console.log('Status:',h.status,'| DB:',h.checks?.database?.status,'| Response:',h.responseTime+'ms')\""
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.1.5",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@react-email/components": "1.0.1",
    "@react-email/render": "2.0.0",
    "@sendgrid/mail": "^8.1.0",
    "@supabase/supabase-js": "^2.86.0",
    "@use-gesture/react": "^10.3.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/og": "^0.8.5",
    "@vercel/speed-insights": "^1.3.1",
    "autoprefixer": "10.4.19",
    "botid": "^1.5.10",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cssnano": "^7.1.2",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^7.1.0",
    "framer-motion": "^11.2.10",
    "imap-simple": "^5.1.0",
    "imapflow": "^1.2.4",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.424.0",
    "mailparser": "^3.9.1",
    "next": "14.2.0",
    "next-intl": "^4.5.6",
    "next-recaptcha-v3": "^1.5.3",
    "nodemailer": "^7.0.10",
    "openai": "^4.56.0",
    "postcss": "8.4.38",
    "react": "18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "react-intersection-observer": "^9.13.1",
    "react-responsive": "^10.0.0",
    "sharp": "^0.33.3",
    "sonner": "^1.4.6",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "3.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.2.0",
    "@types/imap-simple": "^4.2.10",
    "@types/jspdf": "^2.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "20.12.12",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  }
}
