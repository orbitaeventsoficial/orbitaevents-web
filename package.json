{
  "name": "orbitaevents-prova",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "sync:reviews": "node scripts/sync-reviews.mjs",
    "assets:sync": "pnpm run logos:sync && pnpm run normalize:filenames && pnpm run portfolio:avif && pnpm run rename:portfolio && pnpm run generate:portfolio",
    "portfolio:avif": "node scripts/sync-portfolio-avif.mjs",
    "sync:reviews:if-configured": "node -e \"const {execSync}=require('child_process');const hasKeys=Boolean(process.env.SERPAPI_KEY||process.env.OUTSCRAPER_KEY||process.env.OUTSCRAPER_API_KEY);if(!hasKeys){console.log('No review API keys configured - skipping sync:reviews');process.exit(0);}execSync('pnpm run sync:reviews',{stdio:'inherit'});\"",
    "assets:sync:full": "pnpm run assets:sync && pnpm run sync:reviews:if-configured",
    "logos:sync": "node scripts/sync-client-logos.mjs",
    "i18n:packs:guard": "npx tsx scripts/check-packs-i18n.ts",
    "i18n:equipment:guard": "npx tsx scripts/check-equipment-i18n.ts",
    "i18n:packs:sync": "npx tsx scripts/sync-packs-to-db.ts",
    "i18n:packs:fix-or-alert": "pnpm run i18n:packs:sync && pnpm run i18n:packs:guard",
    "autofix:finance:health": "npx tsx scripts/autofix-finance-health.ts",
    "autofix:system:health": "npx tsx scripts/autofix-system-health.ts",
    "theme:admin:check": "node scripts/admin-theme-autofix.mjs --check",
    "qa:visual-overflow": "node scripts/check-visual-overflow.mjs",
    "theme:admin:fix": "node scripts/admin-theme-autofix.mjs --fix",
    "autofix:master": "npx tsx scripts/autofix-master.ts",
    "autofix": "pnpm run autofix:master",
    "qa:scan:web": "node scripts/scan-i18n-leaks.mjs",
    "qa:smoke:i18n": "node scripts/smoke-i18n.mjs",
    "build:assets": "node -e \"const {execSync}=require('child_process');const skip=process.env.SKIP_ASSET_SCRIPTS==='1';if(skip){console.log('SKIP_ASSET_SCRIPTS=1 - skipping asset sync');process.exit(0);}execSync('pnpm run assets:sync:full',{stdio:'inherit'});\"",
    "build": "pnpm run build:ci",
    "build:ci": "pnpm run validate:core && next build",
    "build:with-assets": "pnpm run build:assets && pnpm run build:ci",
    "start": "next start",
    "lint": "next lint",
    "generate:portfolio": "node scripts/generate-portfolio-config.mjs",
    "rename:portfolio": "node scripts/rename-portfolio-images.mjs",
    "normalize:filenames": "node scripts/normalize-filenames.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "seed:blog": "npx tsx prisma/seed-blog.ts",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "monitor": "pnpm exec ts-node scripts/monitor.ts",
    "health": "curl -s https://orbitaevents.com/api/health | node -e \"const d=require('fs').readFileSync(0,'utf8');const h=JSON.parse(d);console.log('Status:',h.status,'| DB:',h.checks?.database?.status,'| Response:',h.responseTime+'ms')\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "scan:hardcoded": "node scripts/scan-hardcoded.js",
    "arch:layer:check": "node scripts/check-layer-catalogs.mjs",
    "arch:task-canonical:check": "node scripts/check-task-canonical.mjs",
    "qa:roadmap-canvis": "node scripts/check-roadmap-canvis.mjs",
    "qa:canonical-svgs": "node scripts/check-canonical-svgs.mjs",
    "qa:canonical-fetches": "node scripts/check-canonical-fetches.mjs",
    "qa:admin-manual-hrefs": "node scripts/check-admin-manual-hrefs.mjs",
    "qa:admin-manual-consistency": "node scripts/check-admin-manual-consistency.mjs",
    "qa:api-admin-auth": "node scripts/check-api-admin-auth.mjs",
    "qa:prisma-in-routes": "node scripts/check-prisma-in-routes.mjs",
    "qa:service-coverage": "node scripts/check-service-coverage.mjs",
    "qa:schema-drift": "node scripts/check-schema-drift.mjs",
    "qa:i18n-keys-sync": "node scripts/check-i18n-keys-sync.mjs",
    "qa:blank-target-rel": "node scripts/check-blank-target-rel.mjs",
    "qa:missing-loading-tsx": "node scripts/check-missing-loading-tsx.mjs",
    "qa:th-scope": "node scripts/check-th-scope.mjs",
    "qa:no-console-log": "node scripts/check-no-console-log.mjs",
    "qa:no-native-dialog": "node scripts/check-no-native-dialog.mjs",
    "qa:no-debugger": "node scripts/check-no-debugger.mjs",
    "qa:no-console-debug": "node scripts/check-no-console-debug.mjs",
    "qa:api-cron-auth": "node scripts/check-api-cron-auth.mjs",
    "qa:no-img-tag": "node scripts/check-no-img-tag.mjs",
    "qa:studio-integrity": "node scripts/check-studio-integrity.mjs",
    "qa:no-zod-parse": "node scripts/check-no-zod-parse.mjs",
    "qa:nonstop-protocol": "node scripts/check-nonstop-protocol.mjs",
    "qa:product-operating-system": "node scripts/check-product-operating-system.mjs",
    "qa:dangerous-html": "node scripts/check-dangerous-html.mjs",
    "qa:visual-identity-bridge": "node scripts/check-visual-identity-bridge.mjs",
    "qa:admin-no-mailto": "node scripts/check-admin-no-mailto.mjs",
    "qa:customer-inline-href": "node scripts/check-customer-inline-href.mjs",
    "qa:no-inline-hex": "node scripts/check-inline-hex.mjs",
    "qa:no-inline-rgba": "node scripts/check-inline-rgba.mjs",
    "qa:no-inline-intl": "node scripts/check-inline-intl.mjs",
    "qa:no-inline-to-locale-string": "node scripts/check-inline-to-locale-string.mjs",
    "qa:no-inline-to-locale-date-time": "node scripts/check-inline-to-locale-date-time.mjs",
    "qa:no-short-locale-literals": "node scripts/check-short-locale-literals.mjs",
    "qa:admin-mutating-fetch-csrf": "node scripts/check-admin-mutating-fetch-csrf.mjs",
    "qa:clipboard-await": "node scripts/check-clipboard-await.mjs",
    "qa:no-admin-slate-gray": "node scripts/check-admin-slate-gray.mjs",
    "qa:no-admin-inline-font-styles": "node scripts/check-admin-inline-font-styles.mjs",
    "qa:no-admin-static-css-var-styles": "node scripts/check-admin-static-css-var-styles.mjs",
    "qa:no-admin-inline-font-size": "node scripts/check-admin-inline-font-size.mjs",
    "qa:no-admin-toFixed-currency": "node scripts/check-admin-toFixed-currency.mjs",
    "qa:admin-mode-prefix": "node scripts/check-admin-mode-prefix.mjs",
    "qa:css-monocapa": "node scripts/check-css-monocapa.mjs",
    "qa:pdf-preview-real-data": "node scripts/check-pdf-preview-real-data.mjs",
    "qa:metadata-i18n-namespaces": "node scripts/check-metadata-i18n-namespaces.mjs",
    "qa:no-silent-catch": "node scripts/check-no-silent-catch.mjs",
    "qa:no-social-split": "node scripts/check-no-social-split.mjs",
    "qa:no-customer-split": "node scripts/check-no-customer-split.mjs",
    "qa:no-admin-gradient-classes": "node scripts/check-no-admin-gradient-classes.mjs",
    "qa:no-inbox-split": "node scripts/check-no-inbox-split.mjs",
    "qa:no-leads-split": "node scripts/check-no-leads-split.mjs",
    "qa:no-bookings-split": "node scripts/check-no-bookings-split.mjs",
    "qa:no-tasks-split": "node scripts/check-no-tasks-split.mjs",
    "audit:visual": "node scripts/audit-visual.mjs",
    "audit:visual:install": "playwright install chromium",
    "validate:core": "pnpm run qa:protocol && pnpm run qa:nonstop-protocol && pnpm run qa:product-operating-system && pnpm run qa:protocol:test && pnpm run qa:encoding && pnpm run qa:language && pnpm run qa:patches && pnpm run qa:visual-overflow && pnpm run qa:visual-identity-bridge && pnpm run qa:message-imports && pnpm run qa:roadmap-canvis && pnpm run qa:canonical-svgs && pnpm run qa:canonical-fetches && pnpm run arch:layer:check && pnpm run arch:task-canonical:check && npx tsc --noEmit && pnpm run i18n:packs:guard && pnpm run i18n:equipment:guard && pnpm run qa:admin-manual-hrefs && pnpm run qa:admin-manual-consistency && pnpm run qa:api-admin-auth && pnpm run qa:prisma-in-routes && pnpm run qa:service-coverage && pnpm run qa:schema-drift && pnpm run qa:i18n-keys-sync && pnpm run qa:metadata-i18n-namespaces && pnpm run qa:blank-target-rel && pnpm run qa:missing-loading-tsx && pnpm run qa:th-scope && pnpm run qa:no-console-log && pnpm run qa:no-native-dialog && pnpm run qa:no-debugger && pnpm run qa:no-console-debug && pnpm run qa:api-cron-auth && pnpm run qa:no-img-tag && pnpm run qa:no-zod-parse && pnpm run qa:dangerous-html && pnpm run qa:admin-no-mailto && pnpm run qa:customer-inline-href && pnpm run qa:no-inline-hex && pnpm run qa:no-inline-rgba && pnpm run qa:no-inline-intl && pnpm run qa:no-inline-to-locale-string && pnpm run qa:no-inline-to-locale-date-time && pnpm run qa:no-short-locale-literals && pnpm run qa:admin-mutating-fetch-csrf && pnpm run qa:clipboard-await && pnpm run qa:no-admin-slate-gray && pnpm run qa:no-admin-inline-font-styles && pnpm run qa:no-admin-static-css-var-styles && pnpm run qa:no-admin-inline-font-size && pnpm run qa:no-admin-toFixed-currency && pnpm run qa:admin-mode-prefix && pnpm run qa:css-monocapa && pnpm run qa:pdf-preview-real-data && pnpm run qa:no-silent-catch && pnpm run qa:no-social-split && pnpm run qa:no-customer-split && pnpm run qa:no-admin-gradient-classes && pnpm run qa:no-inbox-split && pnpm run qa:no-leads-split && pnpm run qa:no-bookings-split && pnpm run qa:no-tasks-split && pnpm run qa:studio-integrity",
    "qa:encoding": "node scripts/check-mojibake.mjs --paths app lib messages prisma",
    "qa:encoding:changed": "node scripts/check-mojibake.mjs --changed",
    "qa:protocol": "node scripts/check-admin-change-log.mjs",
    "qa:message-imports": "node scripts/check-message-imports.mjs",
    "qa:protocol:test": "vitest run __tests__/scripts/",
    "qa:patches": "node scripts/check-patches.mjs",
    "qa:language": "node scripts/check-language-quality.mjs"
  },
  "prisma": {
    "seed": "pnpm exec ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@google-analytics/data": "^5.2.1",
    "@google/generative-ai": "^0.24.1",
    "@marsidev/react-turnstile": "^1.4.1",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "1.0.1",
    "@react-email/render": "2.0.0",
    "@sendgrid/mail": "^8.1.0",
    "@sentry/nextjs": "^10.39.0",
    "autoprefixer": "10.4.19",
    "clsx": "^2.1.1",
