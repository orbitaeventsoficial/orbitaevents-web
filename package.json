    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^11.2.10",
    "imapflow": "^1.2.4",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.424.0",
    "mailparser": "^3.9.1",
    "next": "14.2.35",
    "next-intl": "^4.5.6",
    "nodemailer": "^7.0.10",
    "postcss": "8.4.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "sharp": "^0.33.3",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "3.4.3",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/dompurify": "^3.2.0",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "22.12.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "jsdom": "^27.4.0",
    "pg": "^8.21.0",
    "playwright": "^1.57.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.6.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "semver": "^7.6.3",
      "glob": "10.5.0",
      "tmp": "0.2.4"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "core-js",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
