# ═══════════════════════════════════════════════════════════════════════════
# ORBITA EVENTS - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git (it's in .gitignore)
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE (Required)
# ═══════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host:port/database

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE STORAGE (Required for media uploads)
# ═══════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ═══════════════════════════════════════════════════════════════════════════
# ADMIN AUTHENTICATION (Required)
# ═══════════════════════════════════════════════════════════════════════════
# IMPORTANT: Use strong credentials (minimum 16 characters for password)
ADMIN_USER=admin
ADMIN_PASS=your-secure-password-min-16-chars

# ═══════════════════════════════════════════════════════════════════════════
# CSRF PROTECTION (Required in production)
# ═══════════════════════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
CSRF_SECRET=your-random-secret-min-32-chars

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL SERVICE (Required for contact forms and notifications)
# ═══════════════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@orbitaevents.com
CONTACT_TO=info@orbitaevents.com

# ═══════════════════════════════════════════════════════════════════════════
# RATE LIMITING (Recommended for production)
# ═══════════════════════════════════════════════════════════════════════════
# Upstash Redis for distributed rate limiting in serverless
# Get free tier at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Or use Vercel KV (if using Vercel)
KV_REST_API_URL=https://xxx.kv.vercel-storage.com
KV_REST_API_TOKEN=your-token

# ═══════════════════════════════════════════════════════════════════════════
# SITE CONFIGURATION (Required)
# ═══════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=https://orbitaevents.com
NEXT_PUBLIC_APP_URL=https://orbitaevents.com
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════
# GOOGLE SERVICES (Optional)
# ═══════════════════════════════════════════════════════════════════════════
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Business / Reviews
NEXT_PUBLIC_GOOGLE_PLACE_ID=your-place-id
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://g.page/your-business

# Google Reviews Scraping (for automatic sync)
SERPAPI_KEY=your-serpapi-key
OUTSCRAPER_API_KEY=your-outscraper-key

# DeepL Translation (Optional - recommended for admin translations)
DEEPL_API_KEY=your-deepl-api-key
# Optional override (auto-detected from key if not set)
# DEEPL_BASE_URL=https://api.deepl.com

# ═══════════════════════════════════════════════════════════════════════════
# SOCIAL MEDIA TRACKING (Optional)
# ═══════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_FB_PIXEL_ID=your-pixel-id
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# ═══════════════════════════════════════════════════════════════════════════
# SENTRY ERROR MONITORING (Recommended for production)
# ═══════════════════════════════════════════════════════════════════════════
# Get free account at: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/123456
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token

# ═══════════════════════════════════════════════════════════════════════════
# HEALTH CHECK (Optional)
# ═══════════════════════════════════════════════════════════════════════════
# Set to 'true' to expose detailed health check info (version, environment)
# Leave unset or 'false' in production for security
HEALTH_EXPOSE_DETAILS=false

# ═══════════════════════════════════════════════════════════════════════════
# TAWK.TO LIVE CHAT (Optional)
# ═══════════════════════════════════════════════════════════════════════════
# Free live chat widget for customer support
# Sign up: https://www.tawk.to/
# Dashboard: https://dashboard.tawk.to/#/admin/property
# How to get credentials:
#   1. Create account at https://www.tawk.to/
#   2. Go to Dashboard → Administration → Property
#   3. Copy "Property ID" (format: 5f1234567890abcdef123456)
#   4. Copy "Widget ID" (usually "default" or custom ID)
# Set to "true" to enable live chat, "false" to disable
NEXT_PUBLIC_TAWK_ENABLED=false
NEXT_PUBLIC_TAWK_PROPERTY_ID=your-property-id-here
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# ═══════════════════════════════════════════════════════════════════════════
# VERCEL DEPLOYMENT (Auto-populated by Vercel)
# ═══════════════════════════════════════════════════════════════════════════
# These are automatically set by Vercel, don't add them manually
# VERCEL_GIT_COMMIT_SHA=xxx
# VERCEL_URL=xxx
# VERCEL_ENV=production
