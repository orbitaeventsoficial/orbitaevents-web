// ═══════════════════════════════════════════════════════════════════════════
// RGPD / LOPDGDD - SISTEMA DE PRIVACITAT
// ═══════════════════════════════════════════════════════════════════════════

// Registre de Consentiments
model ConsentRecord {
  id               String   @id @default(cuid())
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])

  // Identificació (si no hi ha customer)
  email            String?
  ipAddress        String?
  userAgent        String?

  // Tipus de consentiment
  consentType      ConsentType
  consentVersion   String   // Versió del document legal (ex: "2.1")

  // Estat
  granted          Boolean  @default(false)
  grantedAt        DateTime?
  revokedAt        DateTime?

  // Context
  source           String   // "WEBSITE", "FORM", "EMAIL", "ADMIN"
  sourceUrl        String?  // URL on es va donar el consentiment
  formId           String?  // ID del formulari

  // Evidència
  rawConsent       Json?    // Dades originals del formulari
  checksumHash     String?  // Hash per verificació d'integritat

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerId])
  @@index([email])
  @@index([consentType])
  @@index([createdAt])
  @@map("consent_records")
}

enum ConsentType {
  GDPR_BASIC           // Consentiment bàsic RGPD
  MARKETING_EMAIL      // Rebre emails comercials
  MARKETING_SMS        // Rebre SMS comercials
  MARKETING_WHATSAPP   // Rebre WhatsApp comercials
  PROFILING            // Perfilat i decisions automatitzades
  THIRD_PARTY          // Compartir amb tercers
  COOKIES_ANALYTICS    // Cookies analítiques
  COOKIES_MARKETING    // Cookies de màrqueting
  COOKIES_FUNCTIONAL   // Cookies funcionals
  TESTIMONIAL_PUBLIC   // Publicar testimoni públicament
  PHOTO_USAGE          // Ús de fotos
}

// Sol·licituds de Drets ARCO (Accés, Rectificació, Cancel·lació, Oposició)
model DataRequest {
  id              String            @id @default(cuid())
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])

  // Identificació del sol·licitant
  requesterEmail  String
  requesterName   String
  requesterPhone  String?

  // Verificació d'identitat
  verificationToken    String   @unique @default(cuid())
  verificationSentAt   DateTime?
  verifiedAt           DateTime?
  identityDocument     String?  // DNI/NIE (xifrat o hash)
  identityVerified     Boolean  @default(false)

  // Tipus de sol·licitud
  requestType     DataRequestType

  // Detalls
  description     String?  @db.Text  // Què vol l'usuari exactament
  specificData    String[] // Camps específics si és parcial
  reason          String?  @db.Text  // Motiu (obligatori per algunes sol·licituds)

  // Estat
  status          DataRequestStatus @default(PENDING)
  priority        Priority          @default(MEDIUM)

  // Processament
  assignedTo      String?
  processedAt     DateTime?
  processedBy     String?
  responseNotes   String?  @db.Text

  // Resposta
  responseType    DataResponseType?
  responseData    Json?             // Dades exportades (si escau)
  responseFileUrl String?           // URL del fitxer (si escau)
  responseSentAt  DateTime?

  // Terminis legals
  legalDeadline   DateTime          // 30 dies màxim per RGPD
  extensionApplied Boolean @default(false)
  extensionReason String?

  // Auditoria
  auditTrail      Json?             // Historial de canvis

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([requesterEmail])
  @@index([status])
  @@index([requestType])
  @@index([legalDeadline])
  @@map("data_requests")
}

enum DataRequestType {
  ACCESS            // Dret d'accés - obtenir còpia de totes les dades
  RECTIFICATION     // Dret de rectificació - corregir dades incorrectes
  ERASURE           // Dret de supressió ("dret a l'oblit")
  RESTRICTION       // Dret de limitació del tractament
  PORTABILITY       // Dret de portabilitat - exportar dades
  OBJECTION         // Dret d'oposició al tractament
  AUTOMATED         // Drets sobre decisions automatitzades
}

enum DataRequestStatus {
  PENDING           // Pendent de verificació
  IDENTITY_REQUIRED // Cal verificar identitat
  VERIFIED          // Identitat verificada, pendent processament
  IN_PROGRESS       // En processament
  COMPLETED         // Completada
  REJECTED          // Rebutjada (amb motiu legal)
  CANCELLED         // Cancel·lada pel sol·licitant
}

enum DataResponseType {
  DATA_PROVIDED     // Dades entregades
  DATA_CORRECTED    // Dades corregides
  DATA_DELETED      // Dades eliminades
  REQUEST_DENIED    // Sol·licitud denegada (amb motiu)
  PARTIAL_RESPONSE  // Resposta parcial
}

// Registre d'Auditoria de Privacitat
model PrivacyAuditLog {
  id            String   @id @default(cuid())

  // Entitat afectada
  entityType    String   // "Customer", "Lead", "Booking", etc.
  entityId      String

  // Acció realitzada
  action        PrivacyAction

  // Actor
  performedBy   String?  // ID d'admin o "SYSTEM" o "USER"
  performerIp   String?
  performerUserAgent String?

  // Dades
  previousData  Json?    // Estat anterior (per rectificacions/supressions)
  newData       Json?    // Estat nou
  affectedFields String[] // Camps afectats

  // Context
  requestId     String?  // ID de DataRequest si aplica
  reason        String?  // Motiu de l'acció
  legalBasis    String?  // Base legal (consentiment, contracte, etc.)

  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
  @@map("privacy_audit_logs")
}

enum PrivacyAction {
  DATA_ACCESSED       // Dades consultades
  DATA_EXPORTED       // Dades exportades
  DATA_CREATED        // Dades creades
  DATA_UPDATED        // Dades actualitzades
  DATA_DELETED        // Dades eliminades
  DATA_ANONYMIZED     // Dades anonimitzades
  CONSENT_GRANTED     // Consentiment atorgat
  CONSENT_REVOKED     // Consentiment revocat
  ACCOUNT_DELETED     // Compte eliminat
  RETENTION_APPLIED   // Política de retenció aplicada
}

// Documents Legals (versions dels textos legals)
model LegalDocument {
  id              String   @id @default(cuid())

  type            LegalDocumentType
  version         String   // "1.0", "1.1", "2.0"
  locale          String   // "es", "ca", "en"

  title           String
  content         String   @db.Text
  summary         String?  @db.Text  // Resum dels canvis

  // Vigència
  effectiveFrom   DateTime
  effectiveUntil  DateTime?

  // Metadades
  isActive        Boolean  @default(true)
  publishedAt     DateTime?
  publishedBy     String?

  // Hash per verificació
  contentHash     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([type, version, locale])
  @@index([type, locale, isActive])
  @@map("legal_documents")
}

enum LegalDocumentType {
  PRIVACY_POLICY      // Política de privacitat
  TERMS_CONDITIONS    // Termes i condicions
  COOKIE_POLICY       // Política de cookies
  CONSENT_FORM        // Formulari de consentiment
  DATA_RETENTION      // Política de retenció
}

// Polítiques de Retenció de Dades
model DataRetentionPolicy {
  id              String   @id @default(cuid())

  name            String
  description     String?

  // Entitat
  entityType      String   // "Customer", "Lead", "Booking"

  // Condicions
  retentionDays   Int      // Dies de retenció
  condition       String?  // Condició SQL/lògica per aplicar

  // Acció
  actionType      RetentionAction

  // Execució
  isActive        Boolean  @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?

  // Estadístiques
  totalProcessed  Int      @default(0)
  lastProcessedCount Int   @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("data_retention_policies")
}

enum RetentionAction {
  DELETE          // Eliminar completament
  ANONYMIZE       // Anonimitzar (mantenir estadístiques)
  ARCHIVE         // Arxivar (moure a cold storage)
  NOTIFY          // Només notificar admin
}

// ═══════════════════════════════════════════════════════════════════════════
// BLOG / CMS
// ═══════════════════════════════════════════════════════════════════════════

model BlogPost {
