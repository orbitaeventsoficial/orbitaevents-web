// prisma/schema.prisma
// Òrbita Events - Sistema Centralitzat Complet
// Versió 2.0 - Desembre 2024

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓ GLOBAL (Settings)
// ═══════════════════════════════════════════════════════════════════════════

model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  category    String      // "stats", "contact", "pricing", "config"
  label       String?
  description String?
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@map("settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ═══════════════════════════════════════════════════════════════════════════
// INVENTARI
// ═══════════════════════════════════════════════════════════════════════════

model InventoryItem {
  id            String            @id @default(cuid())
  code          String            @unique // "ALT-001", "FUM-001"
  name          String
  description   String?
  category      InventoryCategory
  watts         Int?
  value         Float
  status        ItemStatus        @default(AVAILABLE)
  condition     ItemCondition     @default(GOOD)
  isConsumable  Boolean           @default(false)
  stockQuantity Int?
  minStock      Int?
  purchaseDate    DateTime?
  purchasePrice   Float?
  expectedLifeHours Float?  @default(2000)
  imageUrl      String?
  notes         String?

  packItems     PackInventory[]
  extraItems    ExtraInventory[]
  bookingItems  BookingInventory[]
  usageHistory  InventoryUsage[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([category])
  @@index([status])
  @@map("inventory_items")
}

enum InventoryCategory {
  SOUND
  LIGHTING
  EFFECTS
  STRUCTURE
  CABLING
  TECH
  DECORATION_HP
  DECORATION_HW
  DECORATION_GEN
  CONSUMABLE
}

enum ItemStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  BROKEN
  RETIRED
}

enum ItemCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model InventoryUsage {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bookingId String?
  usedAt    DateTime      @default(now())
  hoursUsed Float?
  notes     String?

  @@map("inventory_usage")
}

// ═══════════════════════════════════════════════════════════════════════════
// PACKS
// ═══════════════════════════════════════════════════════════════════════════

model Pack {
  id             String            @id @default(cuid())
  code           String?           @unique
  slug           String            @unique // "flash", "party-starter", "corporate"
  service        String?
  isActive       Boolean           @default(true)
  isFeatured     Boolean           @default(false)
  order          Int               @default(0)
  price          Float
  originalPrice  Float?
  extraHourPrice Float             @default(75)
  minGuests      Int?
  maxGuests      Int?
  djHours        Int
  soundWatts     Int               @default(4000)
  includesFog    Boolean           @default(true)
  includesMic    Boolean           @default(false)

  translations   PackTranslation[]
  inventory      PackInventory[]
  bookings       Booking[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("packs")
}

model PackTranslation {
  id          String   @id @default(cuid())
  packId      String
  pack        Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  locale      String   // "es", "ca", "en"
  name        String
  tagline     String?
  description String?  @db.Text
  badge       String?
  features    String[] // Array de features

  @@unique([packId, locale])
  @@map("pack_translations")
}

model PackInventory {
  id         String        @id @default(cuid())
  packId     String
  pack       Pack          @relation(fields: [packId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int           @default(1)
  isRequired Boolean       @default(true)

  @@unique([packId, itemId])
  @@map("pack_inventory")
}

// ═══════════════════════════════════════════════════════════════════════════
// EXTRAS
// ═══════════════════════════════════════════════════════════════════════════

model Extra {
  id           String             @id @default(cuid())
  slug         String             @unique
  isActive     Boolean            @default(true)
  price        Float
  costPerUnit  Float?
  priceType    PriceType          @default(FIXED)
  order        Int                @default(0)

  translations ExtraTranslation[]
  inventory    ExtraInventory[]
  bookingExtras BookingExtra[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("extras")
}

enum PriceType {
  FIXED
  PER_HOUR
  PER_UNIT
  ON_REQUEST
}

model ExtraTranslation {
  id          String  @id @default(cuid())
  extraId     String
  extra       Extra   @relation(fields: [extraId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?

  @@unique([extraId, locale])
  @@map("extra_translations")
}

model ExtraInventory {
  id       String        @id @default(cuid())
  extraId  String
  extra    Extra         @relation(fields: [extraId], references: [id], onDelete: Cascade)
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int           @default(1)

  @@unique([extraId, itemId])
  @@map("extra_inventory")
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENTS UNIFICATS (CRM)
// ═══════════════════════════════════════════════════════════════════════════

model Customer {
  id                String   @id @default(cuid())
  customerNumber    Int?     @unique @default(autoincrement()) // Número de client: CLI-0001

  // Dades normalitzades
  email             String   @unique
  emailNormalized   String   @unique // lowercase, trimmed
  phone             String?
  phoneNormalized   String?  // només dígits, amb prefix internacional
  name              String
  nameNormalized    String   // lowercase, sense accents, per cerques

  // Document d'identitat (opcional, únic si present)
  dni               String?
  dniNormalized     String?  @unique // uppercase, sense espais ni guions

  // Instagram (opcional)
  instagram         String?
  instagramNormalized String? // sense @, lowercase

  // Metadades
  preferredLocale   String   @default("es")
  source            LeadSource @default(WEBSITE)

  // GDPR
  gdprConsent       Boolean  @default(false)
  gdprConsentDate   DateTime?
  marketingConsent  Boolean  @default(false)
  marketingConsentDate DateTime?

  // Estadístiques
  totalEvents       Int      @default(0)
  totalSpent        Float    @default(0)
  lastEventDate     DateTime?

  // Relacions
  leads             Lead[]
  bookings          Booking[]
  proposals         Proposal[]
  invoices          Invoice[]
  tasks             Task[]
  testimonials      CustomerTestimonial[]
  discountCodes     CustomerDiscountCode[]
  activityLog       CustomerActivity[]
  consentRecords    ConsentRecord[]
  dataRequests      DataRequest[]
  portalAccesses    ClientPortalAccess[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  mergedIntoId      String?  // Si s'ha fusionat amb un altre customer

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([nameNormalized])
  @@index([dniNormalized])
  @@map("customers")
}

model CustomerActivity {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  action      String   // "LEAD_CREATED", "BOOKING_CONFIRMED", "TESTIMONIAL_SUBMITTED", etc
  details     Json?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_activities")
}

// Testimonis dels clients (per generar canvas/imatges)
model CustomerTestimonial {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Contingut
  text            String   @db.Text
  rating          Int      @default(5) // 1-5
  eventType       EventType?
  eventDate       DateTime?

  // Foto del client (opcional)
  photoUrl        String?

  // Permisos
  showName        Boolean  @default(true)
  showPhoto       Boolean  @default(false)
  isApproved      Boolean  @default(false) // Admin ha d'aprovar

  // Canvas generat
  canvasImageUrl  String?  // URL de la imatge generada
  canvasGeneratedAt DateTime?

  // Codi de descompte associat
  discountCodeId  String?

  // Token únic per al formulari públic
  submissionToken String   @unique @default(cuid())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([isApproved])
  @@map("customer_testimonials")
}

// Codis de descompte personalitzats per client
model CustomerDiscountCode {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  code            String   @unique
  discountPercent Float    @default(10)

  // Validesa
  validFrom       DateTime @default(now())
  validUntil      DateTime

  // Ús
  maxUses         Int      @default(1)
  currentUses     Int      @default(0)

  // Origen
  sourceType      String   // "POST_EVENT", "TESTIMONIAL", "REFERRAL", "MANUAL"
  sourceId        String?  // ID del testimonial o booking

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  usedAt          DateTime?

  @@index([code])
  @@index([customerId])
  @@map("customer_discount_codes")
}

// ═══════════════════════════════════════════════════════════════════════════
// LEADS
// ═══════════════════════════════════════════════════════════════════════════

model Lead {
  id               String     @id @default(cuid())

  // Relació amb Customer (opcional, es crea quan es processa)
  customerId       String?
  customer         Customer?  @relation(fields: [customerId], references: [id])

  name             String
  email            String
  phone            String?
  eventType        EventType
  eventDate        DateTime?
  eventSchedule    String?
  eventLocation    String?
  guestCount       Int?
  budget           String?
  message          String?    @db.Text
  interestedPackId String?
  interestedExtras String[]
  source           LeadSource @default(WEBSITE)
  landingPage      String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  status           LeadStatus @default(NEW)
  priority         Priority   @default(MEDIUM)
  assignedTo       String?
  preferredLocale  String     @default("es") // Idioma preferit del client (es, ca, en, ar, fr, zh)

  notes            LeadNote[]
  booking          Booking?
  proposals        Proposal[]
  activities       LeadActivity[]
  tasks            LeadTask[]
  universalTasks   Task[]
  documents        LeadDocument[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  contactedAt      DateTime?
  convertedAt      DateTime?

  // Cache de scoring (actualitzat pel cron commercial-daily)
  cachedScore      Int?
  cachedScoreAt    DateTime?

  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@index([customerId])
  @@index([email])
  @@index([status, createdAt]) // Consultes combinades
  @@index([priority, status]) // Per ordenar leads urgents
  @@map("leads")
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  COMMUNION
  BAPTISM
  GRADUATION
  ANNIVERSARY
  PRIVATE_PARTY
  OTHER
}

enum LeadSource {
  WEBSITE
  CONFIGURATOR
  PHONE
  WHATSAPP
  INSTAGRAM
  WALLAPOP
  REFERRAL
  GOOGLE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  EMAIL
  CALL
  WHATSAPP
  DOCUMENT
  TASK
  SYSTEM
}

enum LeadTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum LeadTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadDocumentType {
  QUOTE
  CONTRACT
  INVOICE
  IMAGE
  FILE
  OTHER
}

enum LeadDocumentSource {
  AUTO
  MANUAL
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdBy String?
  createdAt DateTime @default(now())

  @@map("lead_notes")
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType @default(SYSTEM)
  title       String?
  description String?          @db.Text
  metadata    Json?
  createdBy   String?
  createdAt   DateTime         @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model LeadTask {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  description String?          @db.Text
  dueDate     DateTime?
  status      LeadTaskStatus   @default(OPEN)
  priority    LeadTaskPriority @default(MEDIUM)
  assignedTo  String?
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?

  @@index([leadId, status])
  @@map("lead_tasks")
}

model LeadDocument {
  id        String             @id @default(cuid())
  leadId    String
  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadDocumentType   @default(OTHER)
  source    LeadDocumentSource @default(MANUAL)
  title     String
  fileUrl   String
  filePath  String?
  mimeType  String?
  size      Int?
  createdBy String?
  createdAt DateTime           @default(now())

  @@index([leadId, createdAt])
  @@map("lead_documents")
}

// ═══════════════════════════════════════════════════════════════════════════
// RESERVES (Bookings)
// ═══════════════════════════════════════════════════════════════════════════

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique // "OE-2024-001"
  leadId         String?       @unique
  lead           Lead?         @relation(fields: [leadId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])

  // Client
  clientName      String
  clientEmail     String
  clientPhone     String
  preferredLocale String        @default("es") // Idioma preferit (es, ca, en, ar, fr, zh)

  // Event
  eventType      EventType
  eventDate      DateTime
  eventStartTime String?       // "20:00"
  eventEndTime   String?       // "03:00"
  eventLocation  String
  eventVenue     String?
  guestCount     Int

  // Services
  packId         String
  pack           Pack          @relation(fields: [packId], references: [id])
  extras         BookingExtra[]
  extraHours     Int           @default(0)
  inventory      BookingInventory[]

  // Pricing
  subtotal       Float
  discount       Float         @default(0)
  discountCode   String?
  vatRate        Float         @default(21)
  vatAmount      Float
  total          Float

  // Payments
  depositAmount  Float
  depositPaid    Boolean       @default(false)
  depositPaidAt  DateTime?
  remainingAmount Float
  remainingPaid  Boolean       @default(false)
  remainingPaidAt DateTime?

  // Travel / distance tracking
  distanceKm     Float?        // km anada i tornada
  fuelCostPerKm  Float?        @default(0.15) // cost €/km (gasolina + desgast)
  travelCost     Float?        // cost total desplaçament (calculat o manual)

  // Status
  status         BookingStatus @default(PENDING)
  notes          String?       @db.Text

  // Post-event
  postEventReport    PostEventReport?
  clientSurvey       ClientSurvey?
  clientFeedback     ClientFeedback?
  proposals          Proposal[]
  invoices           Invoice[]
  tasks              Task[]
  portalAccesses     ClientPortalAccess[]
  collaboratorBookings CollaboratorBooking[]

  // Post-event email automation
  postEventEmailSent   Boolean   @default(false)
  postEventEmailSentAt DateTime?
  reviewToken          String?
  reviewSubmittedAt    DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([eventDate])
  @@index([status])
  @@index([packId])
  @@index([createdAt])
  @@index([customerId])
  @@index([reference]) // Per generació de referències
  @@index([status, eventDate]) // Consultes combinades
  @@index([status, eventDate, postEventEmailSent]) // Per cron post-event
  @@map("bookings")
}

model ClientPortalAccess {
  id              String    @id @default(cuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tokenHash       String    @unique
  tokenPrefix     String
  locale          String    @default("ca")
  personalization Json?
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  lastAccessIp    String?
  lastAccessUa    String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId, revokedAt])
  @@index([customerId, revokedAt])
  @@index([expiresAt])
  @@map("client_portal_access")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING_SYNC
  SYNCED
  SYNC_ERROR
  PAID
  CANCELLED
}

model Proposal {
  id            String         @id @default(cuid())
  reference     String         @unique
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId     String?
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  status        ProposalStatus @default(DRAFT)
  locale        String         @default("es")
  currency      String         @default("EUR")
  validityDays  Int            @default(15)
  subtotal      Float
  discount      Float          @default(0)
  vatRate       Float          @default(21)
  vatAmount     Float
  total         Float
  snapshot      Json
  pdfUrl        String?
  pdfKey        String?
  tasks         Task[]

  // Contracte (neix d'una proposta acceptada)
  contractReference  String?
  contractStatus     ContractStatus?
  contractPdfUrl     String?
  contractPdfKey     String?
  contractSentAt     DateTime?
  contractSignedAt   DateTime?
  contractSignedBy   String?
  depositAmount      Float?
  depositDueDate     DateTime?
  finalPaymentDue    DateTime?
  cancellationPolicy String?        @db.Text
  additionalClauses  String?        @db.Text

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sentAt        DateTime?
  acceptedAt    DateTime?

  @@index([customerId, createdAt])
  @@index([leadId])
  @@index([bookingId])
  @@index([status, createdAt])
  @@index([contractStatus])
  @@map("proposals")
}

model Invoice {
  id              String        @id @default(cuid())
  reference       String        @unique // FAC-YYYY-NNNN
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Dades fiscals (snapshot al moment de creació)
  clientName      String
  clientNIF       String?
  clientAddress   String?

  // Imports
  subtotal        Float
  discount        Float         @default(0)
  vatRate         Float         @default(21)
  vatAmount       Float
  total           Float

  // Estat
  status          InvoiceStatus @default(DRAFT)

  // Integració Holded
  holdedInvoiceId   String?
  holdedContactId   String?
  holdedSyncedAt    DateTime?
  holdedSyncError   String?
  holdedInvoiceUrl  String?

  // PDF
  pdfUrl          String?
  pdfKey          String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model Task {
  id               String           @id @default(cuid())
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId           String?
  lead             Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId        String?
  booking          Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  proposalId       String?
  proposal         Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  legacyLeadTaskId String?          @unique
  title            String
  description      String?          @db.Text
  dueDate          DateTime?
  status           LeadTaskStatus   @default(OPEN)
  priority         LeadTaskPriority @default(MEDIUM)
  assignedTo       String?
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  @@index([customerId, status, dueDate])
  @@index([leadId, status])
  @@index([bookingId])
  @@index([proposalId])
  @@map("tasks")
}

model BookingExtra {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraId   String
  extra     Extra   @relation(fields: [extraId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  price     Float

  @@unique([bookingId, extraId])
  @@map("booking_extras")
}

model BookingInventory {
  id              String         @id @default(cuid())
  bookingId       String
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId          String
  item            InventoryItem  @relation(fields: [itemId], references: [id])
  quantity        Int            @default(1)
  checkedOut      Boolean        @default(false)
  checkedIn       Boolean        @default(false)
  conditionBefore ItemCondition?
  conditionAfter  ItemCondition?
  notes           String?

  @@unique([bookingId, itemId])
  @@map("booking_inventory")
}

// ═══════════════════════════════════════════════════════════════════════════
// DISPONIBILITAT
// ═══════════════════════════════════════════════════════════════════════════

model Availability {
  id        String             @id @default(cuid())
  date      DateTime           @unique
  status    AvailabilityStatus @default(AVAILABLE)
  bookingId String?
  note      String?
  updatedAt DateTime           @updatedAt

  @@map("availability")
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

// ═══════════════════════════════════════════════════════════════════════════
// POST-EVENT: INFORME INTERN (el que omples tu)
// ═══════════════════════════════════════════════════════════════════════════

model PostEventReport {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  // TIMING
  actualStartTime  String?
  actualEndTime    String?
  actualGuestCount Int?
  punctuality      String? // EARLY, ON_TIME, SLIGHT_DELAY, DELAYED

  // EQUIP
  soundQuality     Int?    // 1-5
  maxVolumeUsed    Int?    // %
  soundProblems    Boolean @default(false)
  soundProblemsDetail String?
  lightingUsed     String[] // ["MOV-001", "MOV-002"]
  effectsUsed      String[] // ["FUM-001"]
  effectsReaction  String? // INDIFFERENT, GOOD, WOW, INCREDIBLE
