  // AMBIENT
  temperature      String? // COLD, COOL, IDEAL, WARM, HOT
  maxDancefloor    Int?    // %
  peakTime         String? // "01:30"
  avgDancing       String? // BELOW_25, 25_50, 50_75, ABOVE_75
  overallVibe      String? // COLD, CORRECT, GOOD_VIBES, INCREDIBLE

  // MÚSICA
  mainStyle        String?
  genresWorked     String[]
  genresFailed     String[]
  hitSongs         String? @db.Text
  memorableMoment  String? @db.Text

  // ANIMACIÓ
  animationLevel   String? // ZERO, MINIMAL, MODERATE, HIGH, SHOWMAN
  microphoneUsed   Boolean @default(false)
  gamesPlayed      String[]

  // CLIENT
  perceivedSatisfaction String? // UNSATISFIED, CORRECT, HAPPY, DELIGHTED
  clientComments   String? @db.Text

  // INCIDÈNCIES
  hadIncidents     Boolean @default(false)
  incidentType     String? // TECHNICAL, LOGISTICS, CLIENT, PUBLIC, OTHER
  incidentDescription String? @db.Text
  incidentResolution String? @db.Text
  incidentImpact   String? // NONE, MINIMAL, MODERATE, HIGH, CRITICAL

  // VALORACIÓ
  overallRating    Int?    // 1-5
  whatWorkedBest   String? @db.Text
  whatToImprove    String? @db.Text
  lessonsLearned   String? @db.Text
  wouldRepeatVenue Boolean?
  stressLevel      Int?    // 1-10

  // MEDIA
  photosTaken      Int?
  videosTaken      Int?
  iconicPhotoUrl   String?
  mediaPermission  String? // YES_FULL, YES_ANONYMOUS, NO

  status           String  @default("DRAFT") // DRAFT, COMPLETED
  completedAt      DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("post_event_reports")
}

