enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING_SYNC
  SYNCED
  SYNC_ERROR
  PAID
  CANCELLED
}

model Proposal {
  id           String         @id @default(cuid())
  reference    String         @unique
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId       String?
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  status       ProposalStatus @default(DRAFT)
  locale       String         @default("es")
  currency     String         @default("EUR")
  validityDays Int            @default(15)
  subtotal     Float
  discount     Float          @default(0)
  vatRate      Float          @default(21)
  vatAmount    Float
  total        Float
  snapshot     Json
  pdfUrl       String?
  pdfKey       String?
  tasks        Task[]

  // Contracte (neix d'una proposta acceptada)
  contractReference  String?
  contractStatus     ContractStatus?
  contractPdfUrl     String?
  contractPdfKey     String?
  contractSentAt     DateTime?
  contractSignedAt     DateTime?
  contractSignedBy     String?
  contractSignatureIp   String?
  contractSignatureUa   String?       @db.Text
  contractSignatureBlob String?       @db.Text
  depositAmount         Float?
  depositDueDate     DateTime?
  finalPaymentDue    DateTime?
  cancellationPolicy String?         @db.Text
  additionalClauses  String?         @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sentAt     DateTime?
  acceptedAt DateTime?

  @@index([status])
  @@index([customerId, createdAt])
  @@index([leadId])
  @@index([bookingId])
  @@index([status, createdAt])
  @@index([contractStatus])
  @@map("proposals")
}

model Invoice {
  id         String   @id @default(cuid())
  reference  String   @unique // FAC-YYYY-NNNN
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Dades fiscals (snapshot al moment de creació)
  clientName    String
  clientNIF     String?
  clientAddress String?

  // Imports
  subtotal  Float
  discount  Float @default(0)
  vatRate   Float @default(21)
  vatAmount Float
  total     Float

  // Estat
  status InvoiceStatus @default(DRAFT)

  // Integració Holded
  holdedInvoiceId  String?
  holdedContactId  String?
  holdedSyncedAt   DateTime?
  holdedSyncError  String?
  holdedInvoiceUrl String?

  // PDF
  pdfUrl String?
  pdfKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([customerId])
  @@index([status])
  @@index([customerId, status]) // Per cross-queries de client i estat
  @@map("invoices")
}

model Task {
  id               String       @id @default(cuid())
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId           String?
  lead             Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingId        String?
  booking          Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  proposalId       String?
  proposal         Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  legacyLeadTaskId String?      @unique
  title            String
  description      String?      @db.Text
  dueDate          DateTime?
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  assignedTo       String?
  createdBy        String?
  source           String?
  autoRule         String?
  dedupeKey        String?      @unique
  resolutionNote   String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  completedAt      DateTime?

  @@index([status])
  @@index([customerId, status, dueDate])
  @@index([leadId, status])
  @@index([bookingId])
  @@index([proposalId])
  @@index([source])
  @@index([autoRule])
  @@map("tasks")
}

model BookingExtra {
