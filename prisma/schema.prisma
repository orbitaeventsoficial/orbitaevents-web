// prisma/schema.prisma
// Òrbita Events - Sistema Centralitzat Complet
// Versió 2.0 - Desembre 2024

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓ GLOBAL (Settings)
// ═══════════════════════════════════════════════════════════════════════════

model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  category    String // "stats", "contact", "pricing", "config"
  label       String?
  description String?
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@map("settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ═══════════════════════════════════════════════════════════════════════════
// INVENTARI
// ═══════════════════════════════════════════════════════════════════════════

model InventoryItem {
  id                String            @id @default(cuid())
  code              String            @unique // "ALT-001", "FUM-001"
  name              String
  description       String?
  category          InventoryCategory
  watts             Int?
  value             Float
  status            ItemStatus        @default(AVAILABLE)
  condition         ItemCondition     @default(GOOD)
  isConsumable      Boolean           @default(false)
  stockQuantity     Int?
  minStock          Int?
  purchaseDate      DateTime?
  purchasePrice     Float?
  expectedLifeHours Float?            @default(2000)
  imageUrl          String?
  notes             String?

  packItems    PackInventory[]
  extraItems   ExtraInventory[]
  bookingItems BookingInventory[]
  usageHistory InventoryUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@map("inventory_items")
}

enum InventoryCategory {
  SOUND
  LIGHTING
  EFFECTS
  STRUCTURE
  CABLING
  TECH
  DECORATION_HP
  DECORATION_HW
  DECORATION_GEN
  CONSUMABLE
}

enum ItemStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  BROKEN
  RETIRED
}

enum ItemCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model InventoryUsage {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  usedAt    DateTime      @default(now())
  hoursUsed Float?
  notes     String?

  @@index([itemId])
  @@index([bookingId])
  @@map("inventory_usage")
}

// ═══════════════════════════════════════════════════════════════════════════
// PACKS
// ═══════════════════════════════════════════════════════════════════════════

model Pack {
  id             String  @id @default(cuid())
  code           String? @unique
  slug           String  @unique // "flash", "party-starter", "corporate"
  service        String?
  isActive       Boolean @default(true)
  isFeatured     Boolean @default(false)
  order          Int     @default(0)
  price          Float
  originalPrice  Float?
  extraHourPrice Float   @default(75)
  minGuests      Int?
  maxGuests      Int?
  djHours        Int
  soundWatts     Int     @default(4000)
  includesFog    Boolean @default(true)
  includesMic    Boolean @default(false)

  translations PackTranslation[]
  inventory    PackInventory[]
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packs")
}

model PackTranslation {
  id          String   @id @default(cuid())
  packId      String
  pack        Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  locale      String // "es", "ca", "en"
  name        String
  tagline     String?
  description String?  @db.Text
  badge       String?
  features    String[] // Array de features

  @@unique([packId, locale])
  @@map("pack_translations")
}

model PackInventory {
  id         String        @id @default(cuid())
  packId     String
  pack       Pack          @relation(fields: [packId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int           @default(1)
  isRequired Boolean       @default(true)

  @@unique([packId, itemId])
  @@map("pack_inventory")
}

// ═══════════════════════════════════════════════════════════════════════════
// EXTRAS
// ═══════════════════════════════════════════════════════════════════════════

model Extra {
  id          String    @id @default(cuid())
  slug        String    @unique
  isActive    Boolean   @default(true)
  price       Float
  costPerUnit Float?
  priceType   PriceType @default(FIXED)
  order       Int       @default(0)

  translations  ExtraTranslation[]
  inventory     ExtraInventory[]
  bookingExtras BookingExtra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("extras")
}

enum PriceType {
  FIXED
  PER_HOUR
  PER_UNIT
  ON_REQUEST
}

model ExtraTranslation {
  id          String  @id @default(cuid())
  extraId     String
  extra       Extra   @relation(fields: [extraId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?

  @@unique([extraId, locale])
  @@map("extra_translations")
}

model ExtraInventory {
  id       String        @id @default(cuid())
  extraId  String
  extra    Extra         @relation(fields: [extraId], references: [id], onDelete: Cascade)
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int           @default(1)

  @@unique([extraId, itemId])
  @@map("extra_inventory")
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENTS UNIFICATS (CRM)
// ═══════════════════════════════════════════════════════════════════════════

model Customer {
  id             String @id @default(cuid())
  customerNumber Int?   @unique @default(autoincrement()) // Número de client: CLI-0001

  // Dades normalitzades
  email           String  @unique
  emailNormalized String  @unique // lowercase, trimmed
  phone           String?
  phoneNormalized String? // només dígits, amb prefix internacional
  name            String
  nameNormalized  String // lowercase, sense accents, per cerques

  // Document d'identitat (opcional, únic si present)
  dni           String?
  dniNormalized String? @unique // uppercase, sense espais ni guions

  // Instagram (opcional)
  instagram           String?
  instagramNormalized String? // sense @, lowercase

  // Metadades
  preferredLocale String     @default("es")
  source          LeadSource @default(WEBSITE)

  // GDPR
  gdprConsent          Boolean   @default(false)
  gdprConsentDate      DateTime?
  marketingConsent     Boolean   @default(false)
  marketingConsentDate DateTime?

  // Estadístiques
  totalEvents   Int       @default(0)
  totalSpent    Float     @default(0)
  lastEventDate DateTime?

  // CRM Potenciat
  tags            String[]          @default([]) // Etiquetes lliures: "VIP", "Corporatiu", "Repeater", etc.
  lifecycleStage  CustomerLifecycle @default(NEW)
  preferences     Json? // Gustos musicals, venues preferits, necessitats especials
  healthScore     Int? // 0-100, calculat pel cron
  birthday        DateTime?
  lastContactedAt DateTime?
  referredById    String?
  referredBy      Customer?         @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       Customer[]        @relation("CustomerReferrals")

  // Relacions
  leads          Lead[]
  bookings       Booking[]
  proposals      Proposal[]
  invoices       Invoice[]
  tasks          Task[]
  testimonials   CustomerTestimonial[]
  discountCodes  CustomerDiscountCode[]
  activityLog    CustomerActivity[]
  consentRecords ConsentRecord[]
  dataRequests   DataRequest[]
  portalAccesses ClientPortalAccess[]
  contacts       CustomerContact[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  mergedIntoId String? // Si s'ha fusionat amb un altre customer

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([nameNormalized])
  @@index([dniNormalized])
  @@index([lifecycleStage])
  @@index([healthScore])
  @@index([referredById])
  @@map("customers")
}

model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String? // "Director comercial", "Responsable d'events", etc.
  email      String?
  phone      String?
  notes      String?
  isPrimary  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_contacts")
}

enum CustomerLifecycle {
  NEW // Acaba d'entrar, encara sense booking
  PROSPECT // Té lead actiu però sense conversió
  FIRST_TIME // Ha fet 1 booking (primer event)
  RETURNING // Ha fet 2+ bookings
  VIP // Alta recurrència o alt valor
  DORMANT // >6 mesos sense activitat
  CHURNED // >12 mesos sense activitat, considerat perdut
}

model CustomerActivity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  action     String // "LEAD_CREATED", "BOOKING_CONFIRMED", "TESTIMONIAL_SUBMITTED", etc
  details    Json?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_activities")
}

// Testimonis dels clients (per generar canvas/imatges)
model CustomerTestimonial {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Contingut
  text      String     @db.Text
  rating    Int        @default(5) // 1-5
  eventType EventType?
  eventDate DateTime?

  // Foto del client (opcional)
  photoUrl String?

  // Permisos
  showName   Boolean @default(true)
  showPhoto  Boolean @default(false)
  isApproved Boolean @default(false) // Admin ha d'aprovar

  // Canvas generat
  canvasImageUrl    String? // URL de la imatge generada
  canvasGeneratedAt DateTime?

  // Codi de descompte associat
  discountCodeId String?

  // Token únic per al formulari públic
  submissionToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([isApproved])
  @@map("customer_testimonials")
}

// Codis de descompte personalitzats per client
model CustomerDiscountCode {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  code            String @unique
  discountPercent Float  @default(10)

  // Validesa
  validFrom  DateTime @default(now())
  validUntil DateTime

  // Ús
  maxUses     Int @default(1)
  currentUses Int @default(0)

  // Origen
  sourceType String // "POST_EVENT", "TESTIMONIAL", "REFERRAL", "MANUAL"
  sourceId   String? // ID del testimonial o booking

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([code])
  @@index([customerId])
  @@map("customer_discount_codes")
}

// ═══════════════════════════════════════════════════════════════════════════
// LEADS
// ═══════════════════════════════════════════════════════════════════════════

model Lead {
  id String @id @default(cuid())

  // Relació amb Customer (opcional, es crea quan es processa)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  name             String
  email            String
  phone            String?
  dni              String?
  eventType        EventType
  eventDate        DateTime?
  eventStartTime   String?   // "13:00"
  eventEndTime     String?   // "16:00"
  eventSchedule    String?
  eventLocation    String?
  guestCount       Int?
  budget           String?
  message          String?    @db.Text
  interestedPackId String?
  interestedExtras String[]
  source           LeadSource @default(WEBSITE)
  sourceCollaboratorId String?
  sourceCollaborator   Collaborator? @relation("LeadSourceCollaborator", fields: [sourceCollaboratorId], references: [id], onDelete: SetNull)
  landingPage      String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  status           LeadStatus @default(NEW)
  priority         Priority   @default(MEDIUM)
  assignedTo       String?
  preferredLocale  String     @default("es") // Idioma preferit del client (es, ca, en, ar, fr, zh)

  notes          LeadNote[]
  booking        Booking?
  proposals      Proposal[]
  activities     LeadActivity[]
  universalTasks Task[]
  documents      LeadDocument[]
  dossiers       Dossier[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contactedAt DateTime?
  convertedAt DateTime?

  // Contacte específic de l'esdeveniment (pot diferir del client)
  eventPhone   String? // telèfon de contacte el dia del bolo
  eventAddress String? // adreça de l'event (venue, domicili, etc.)

  // Audit trail de pèrdua: per què i quan s'ha marcat el lead com LOST
  lostReason String?
  lostAt     DateTime?

  // Nurturing: seqüència de follow-ups automàtics
  nurturingStep   Int       @default(0) // 0 = cap follow-up enviat, 1..N = pas actual
  lastNurturingAt DateTime? // Quan es va enviar l'últim follow-up
  nurturingDone   Boolean   @default(false) // True quan s'ha completat tota la cadència

  // Cache de scoring (actualitzat pel cron commercial-daily)
  cachedScore   Int?
  cachedScoreAt DateTime?

  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@index([customerId])
  @@index([sourceCollaboratorId])
  @@index([email])
  @@index([status, createdAt]) // Consultes combinades
  @@index([priority, status]) // Per ordenar leads urgents
  @@index([status, updatedAt]) // Per leads actius i frescor de pipeline
  @@index([lostReason]) // Audit trail: query per motiu de pèrdua
  @@map("leads")
}

// ═══════════════════════════════════════════════════════════════════════════
// DOSSIERS
// ═══════════════════════════════════════════════════════════════════════════

model Dossier {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Dades del client al moment de la generació
  nom         String
  empresa     String?
  telefon     String?
  email       String?
  eventDesc   String?
  salutacio   String?   @db.Text

  // Productes seleccionats (array d'IDs: 'bingo-musical', 'batalla-musical', 'dj')
  productIds  String[]

  // Estat d'enviament
  sentAt      DateTime?
  sentTo      String?   // email al qual es va enviar

  // Paperera de reciclatge (30 dies)
  deletedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("dossiers")
}

// Arxiu històric de leads LOST eliminats (snapshot abans de purgar).
// Snapshot pres a `leadCleanupService` (cron auto-delete >90 dies) i a
// `leadRouteService.deleteLeadIfAllowed` (delete manual). El registre original
// de `leads` desapareix; aquest arxiu queda per a stats històriques.
model LeadArchive {
  id        String @id @default(cuid())
  leadId    String // id original del lead a la taula `leads` (referència, no FK)

  // Snapshot dels camps clau del lead al moment de la purga
  name           String
  email          String
  phone          String?
  eventType      EventType
  eventDate      DateTime?
  eventLocation  String?
  guestCount     Int?
  source         LeadSource
  estimatedValue Float? // total del proposal SENT/ACCEPTED més recent, si n'hi havia
  priority       Priority
  assignedTo     String?

  // Audit del LOST
  lostReason String? // motiu canònic (LEAD_LOST_REASONS) o null si LOST sense motiu
  lostAt     DateTime?

  // Timestamps originals
  originalCreatedAt DateTime
  originalUpdatedAt DateTime
  contactedAt       DateTime?

  // Quan es va arxivar (auto-delete cron o manual)
  archivedAt DateTime @default(now())
  archivedBy String? // 'system:lead-cleanup' (cron) o 'admin' (manual)

  @@index([archivedAt])
  @@index([lostReason])
  @@index([eventType])
  @@index([source])
  @@index([lostAt])
  @@map("lead_archive")
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  COMMUNION
  BAPTISM
  GRADUATION
  ANNIVERSARY
  PRIVATE_PARTY
  OTHER
}

enum LeadSource {
  WEBSITE
  CONFIGURATOR
  PHONE
  WHATSAPP
  INSTAGRAM
  WALLAPOP
  REFERRAL
  GOOGLE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  EMAIL
  CALL
  WHATSAPP
  DOCUMENT
  TASK
  SYSTEM
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("LeadTaskStatus")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("LeadTaskPriority")
}

enum LeadDocumentType {
  QUOTE
  CONTRACT
  INVOICE
  IMAGE
  FILE
  OTHER
}

enum LeadDocumentSource {
  AUTO
  MANUAL
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdBy String?
  createdAt DateTime @default(now())

  @@map("lead_notes")
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType @default(SYSTEM)
  title       String?
  description String?          @db.Text
  metadata    Json?
  createdBy   String?
  createdAt   DateTime         @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model LeadDocument {
  id        String             @id @default(cuid())
  leadId    String
  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadDocumentType   @default(OTHER)
  source    LeadDocumentSource @default(MANUAL)
  title     String
  fileUrl   String
  filePath  String?
  mimeType  String?
  size      Int?
  createdBy String?
  createdAt DateTime           @default(now())

  @@index([leadId, createdAt])
  @@map("lead_documents")
}

// ═══════════════════════════════════════════════════════════════════════════
// RESERVES (Bookings)
// ═══════════════════════════════════════════════════════════════════════════

model Booking {
  id         String    @id @default(cuid())
  reference  String    @unique // "OE-2024-001"
  leadId     String?   @unique
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sourceCollaboratorId String?
  sourceCollaborator   Collaborator? @relation("BookingSourceCollaborator", fields: [sourceCollaboratorId], references: [id], onDelete: SetNull)
  billedCollaboratorId String?
  billedCollaborator   Collaborator? @relation("BookingBilledCollaborator", fields: [billedCollaboratorId], references: [id], onDelete: SetNull)

  // Client
  clientName      String
  clientEmail     String
  clientPhone     String
  preferredLocale String @default("es") // Idioma preferit (es, ca, en, ar, fr, zh)

  // Event
  eventType      EventType
  eventDate      DateTime
  eventStartTime String? // "20:00"
  eventEndTime   String? // "03:00"
  eventLocation  String
  eventVenue     String?
  guestCount     Int

  // Services
  packId     String
  pack       Pack               @relation(fields: [packId], references: [id])
  extras     BookingExtra[]
  extraHours Int                @default(0)
  inventory  BookingInventory[]

  // Pricing
  subtotal     Float
  discount     Float   @default(0)
  discountCode String?
  vatRate      Float   @default(0)
  vatAmount    Float
  total        Float

  // Payments
  depositAmount   Float
  depositPaid     Boolean   @default(false)
  depositPaidAt   DateTime?
  depositPaymentUrl String?
  remainingAmount Float
  remainingPaid   Boolean   @default(false)
  remainingPaidAt DateTime?
  remainingPaymentUrl String?

  // Bizum (client declara pagament; admin confirma)
  depositBizumDeclaredAt   DateTime?
  remainingBizumDeclaredAt DateTime?

  // Contacte específic de l'esdeveniment (pot diferir del client)
  eventPhone   String? // telèfon de contacte el dia del bolo
  eventAddress String? // adreça exacta de l'event (venue, domicili, sala, etc.)

  // Cobrament i facturació
  paymentMethod   String  @default("INVOICE") // INVOICE | CASH | TRANSFER
  invoiceRequired Boolean @default(false)      // el client vol factura?
  cashAmount      Float?                       // import cobrat en efectiu (si paymentMethod=CASH)

  // Travel / distance tracking
  distanceKm    Float? // km anada i tornada
  fuelCostPerKm Float? @default(0.15) // cost €/km (gasolina + desgast)
  travelCost    Float? // cost total desplaçament (calculat o manual)

  // Status
  status BookingStatus @default(PENDING)
  notes  String?       @db.Text

  // Post-event
  postEventReport      PostEventReport?
  clientSurvey         ClientSurvey?
  clientFeedback       ClientFeedback?
  proposals            Proposal[]
  invoices             Invoice[]
  tasks                Task[]
  portalAccesses       ClientPortalAccess[]
  collaboratorBookings CollaboratorBooking[]
  serviceLines         BookingServiceLine[]
  galleryPhotos        BookingGalleryPhoto[]
  inventoryUsages      InventoryUsage[]
  availability         Availability[]
  socialPosts          SocialPost[]

  // Post-event email automation
  postEventEmailSent   Boolean   @default(false)
  postEventEmailSentAt DateTime?
  reviewToken          String?
  reviewSubmittedAt    DateTime?

  // Questionnaire
  questionnaireResponses QuestionnaireResponse[]

  // Gallery share
  galleryShareToken    String?  @unique
  gallerySharePassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventDate])
  @@index([status])
  @@index([packId])
  @@index([createdAt])
  @@index([customerId])
  @@index([sourceCollaboratorId])
  @@index([billedCollaboratorId])
  @@index([reference]) // Per generació de referències
  @@index([status, eventDate]) // Consultes combinades
  @@index([status, eventDate, postEventEmailSent]) // Per cron post-event
  @@index([depositPaid, eventDate]) // Per filtres de cobrament i agenda
  @@map("bookings")
}

model QuestionnaireTemplate {
  id          String    @id @default(cuid())
  title       String
  description String?
  questions   Json
  isActive    Boolean   @default(true)
  responses   QuestionnaireResponse[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("questionnaire_templates")
}

model QuestionnaireResponse {
  id         String                @id @default(cuid())
  bookingId  String
  booking    Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  templateId String
  template   QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers    Json
  submittedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([bookingId, templateId])
  @@index([bookingId])
  @@index([templateId])
  @@map("questionnaire_responses")
}

model ClientPortalAccess {
  id              String    @id @default(cuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tokenHash       String    @unique
  tokenPrefix     String
  locale          String    @default("ca")
  personalization Json?
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  lastAccessIp    String?
  lastAccessUa    String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId, revokedAt])
  @@index([customerId, revokedAt])
  @@index([expiresAt])
  @@map("client_portal_access")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

enum BookingServiceLineKind {
  DJ
  SOUND_TECH
  PROVIDER_SERVICE
  EQUIPMENT
  OTHER
}

model BookingServiceLine {
