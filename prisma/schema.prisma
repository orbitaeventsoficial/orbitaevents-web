// ═══════════════════════════════════════════════════════════════════════════
// RGPD / LOPDGDD - SISTEMA DE PRIVACITAT
// ═══════════════════════════════════════════════════════════════════════════

// Registre de Consentiments
model ConsentRecord {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Identificació (si no hi ha customer)
  email     String?
  ipAddress String?
  userAgent String?

  // Tipus de consentiment
  consentType    ConsentType
  consentVersion String // Versió del document legal (ex: "2.1")

  // Estat
  granted   Boolean   @default(false)
  grantedAt DateTime?
  revokedAt DateTime?

  // Context
  source    String // "WEBSITE", "FORM", "EMAIL", "ADMIN"
  sourceUrl String? // URL on es va donar el consentiment
  formId    String? // ID del formulari

  // Evidència
  rawConsent   Json? // Dades originals del formulari
  checksumHash String? // Hash per verificació d'integritat

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([email])
  @@index([consentType])
  @@index([createdAt])
  @@map("consent_records")
}

enum ConsentType {
  GDPR_BASIC // Consentiment bàsic RGPD
  MARKETING_EMAIL // Rebre emails comercials
  MARKETING_SMS // Rebre SMS comercials
  MARKETING_WHATSAPP // Rebre WhatsApp comercials
  PROFILING // Perfilat i decisions automatitzades
  THIRD_PARTY // Compartir amb tercers
  COOKIES_ANALYTICS // Cookies analítiques
  COOKIES_MARKETING // Cookies de màrqueting
  COOKIES_FUNCTIONAL // Cookies funcionals
  TESTIMONIAL_PUBLIC // Publicar testimoni públicament
  PHOTO_USAGE // Ús de fotos
}

// Sol·licituds de Drets ARCO (Accés, Rectificació, Cancel·lació, Oposició)
model DataRequest {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Identificació del sol·licitant
  requesterEmail String
  requesterName  String
  requesterPhone String?

  // Verificació d'identitat
  verificationToken  String    @unique @default(cuid())
  verificationSentAt DateTime?
  verifiedAt         DateTime?
  identityDocument   String? // DNI/NIE (xifrat o hash)
  identityVerified   Boolean   @default(false)

  // Tipus de sol·licitud
  requestType DataRequestType

  // Detalls
  description  String?  @db.Text // Què vol l'usuari exactament
  specificData String[] // Camps específics si és parcial
  reason       String?  @db.Text // Motiu (obligatori per algunes sol·licituds)

  // Estat
  status   DataRequestStatus @default(PENDING)
  priority Priority          @default(MEDIUM)

  // Processament
  assignedTo    String?
  processedAt   DateTime?
  processedBy   String?
  responseNotes String?   @db.Text

  // Resposta
  responseType    DataResponseType?
  responseData    Json? // Dades exportades (si escau)
  responseFileUrl String? // URL del fitxer (si escau)
  responseSentAt  DateTime?

  // Terminis legals
  legalDeadline    DateTime // 30 dies màxim per RGPD
  extensionApplied Boolean  @default(false)
  extensionReason  String?

  // Auditoria
  auditTrail Json? // Historial de canvis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([requesterEmail])
  @@index([status])
  @@index([requestType])
  @@index([legalDeadline])
  @@map("data_requests")
}

enum DataRequestType {
  ACCESS // Dret d'accés - obtenir còpia de totes les dades
  RECTIFICATION // Dret de rectificació - corregir dades incorrectes
  ERASURE // Dret de supressió ("dret a l'oblit")
  RESTRICTION // Dret de limitació del tractament
  PORTABILITY // Dret de portabilitat - exportar dades
  OBJECTION // Dret d'oposició al tractament
  AUTOMATED // Drets sobre decisions automatitzades
}

enum DataRequestStatus {
  PENDING // Pendent de verificació
  IDENTITY_REQUIRED // Cal verificar identitat
  VERIFIED // Identitat verificada, pendent processament
  IN_PROGRESS // En processament
  COMPLETED // Completada
  REJECTED // Rebutjada (amb motiu legal)
  CANCELLED // Cancel·lada pel sol·licitant
}

enum DataResponseType {
  DATA_PROVIDED // Dades entregades
  DATA_CORRECTED // Dades corregides
  DATA_DELETED // Dades eliminades
  REQUEST_DENIED // Sol·licitud denegada (amb motiu)
  PARTIAL_RESPONSE // Resposta parcial
}

// Registre d'Auditoria de Privacitat
model PrivacyAuditLog {
  id String @id @default(cuid())

  // Entitat afectada
  entityType String // "Customer", "Lead", "Booking", etc.
  entityId   String

  // Acció realitzada
  action PrivacyAction

  // Actor
  performedBy        String? // ID d'admin o "SYSTEM" o "USER"
  performerIp        String?
  performerUserAgent String?

  // Dades
  previousData   Json? // Estat anterior (per rectificacions/supressions)
  newData        Json? // Estat nou
  affectedFields String[] // Camps afectats

  // Context
  requestId  String? // ID de DataRequest si aplica
  reason     String? // Motiu de l'acció
  legalBasis String? // Base legal (consentiment, contracte, etc.)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
  @@map("privacy_audit_logs")
}

enum PrivacyAction {
  DATA_ACCESSED // Dades consultades
  DATA_EXPORTED // Dades exportades
  DATA_CREATED // Dades creades
  DATA_UPDATED // Dades actualitzades
  DATA_DELETED // Dades eliminades
  DATA_ANONYMIZED // Dades anonimitzades
  CONSENT_GRANTED // Consentiment atorgat
  CONSENT_REVOKED // Consentiment revocat
  ACCOUNT_DELETED // Compte eliminat
  RETENTION_APPLIED // Política de retenció aplicada
}

// Documents Legals (versions dels textos legals)
model LegalDocument {
  id String @id @default(cuid())

  type    LegalDocumentType
  version String // "1.0", "1.1", "2.0"
  locale  String // "es", "ca", "en"

  title   String
  content String  @db.Text
  summary String? @db.Text // Resum dels canvis

  // Vigència
  effectiveFrom  DateTime
  effectiveUntil DateTime?

  // Metadades
  isActive    Boolean   @default(true)
  publishedAt DateTime?
  publishedBy String?

  // Hash per verificació
  contentHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, version, locale])
  @@index([type, locale, isActive])
  @@map("legal_documents")
}

enum LegalDocumentType {
  PRIVACY_POLICY // Política de privacitat
  TERMS_CONDITIONS // Termes i condicions
  COOKIE_POLICY // Política de cookies
  CONSENT_FORM // Formulari de consentiment
  DATA_RETENTION // Política de retenció
}

// Polítiques de Retenció de Dades
model DataRetentionPolicy {
  id String @id @default(cuid())

  name        String
  description String?

  // Entitat
  entityType String // "Customer", "Lead", "Booking"

  // Condicions
  retentionDays Int // Dies de retenció
  condition     String? // Condició SQL/lògica per aplicar

  // Acció
  actionType RetentionAction

  // Execució
  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  // Estadístiques
  totalProcessed     Int @default(0)
  lastProcessedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("data_retention_policies")
}

enum RetentionAction {
  DELETE // Eliminar completament
  ANONYMIZE // Anonimitzar (mantenir estadístiques)
  ARCHIVE // Arxivar (moure a cold storage)
  NOTIFY // Només notificar admin
}

// ═══════════════════════════════════════════════════════════════════════════
// BLOG / CMS
// ═══════════════════════════════════════════════════════════════════════════

model BlogPost {
  id            String                @id @default(cuid())
  slug          String                @unique
  author        String                @default("Òrbita Events")
  category      String                @default("general")
  tags          String[]
  featuredImage String?
  isPublished   Boolean               @default(false)
  publishedAt   DateTime?
  viewCount     Int                   @default(0)
  readingTime   Int? // Minutes
  translations  BlogPostTranslation[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id              String   @id @default(cuid())
  postId          String
  post            BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale          String // "es", "ca"
  title           String
  excerpt         String   @db.Text
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?

  @@unique([postId, locale])
  @@map("blog_post_translations")
}

// ═══════════════════════════════════════════════════════════════════════════
// PLANTILLES EMAIL
// ═══════════════════════════════════════════════════════════════════════════

model EmailTemplate {
  id          String   @id @default(cuid())
  slug        String // ex: "booking_confirmation", "post_event", "payment_reminder"
  locale      String // "ca", "es", "en"
  subject     String
  bodyHtml    String   @db.Text
  description String? // Descripció per l'admin
  variables   String? // JSON: variables disponibles, ex: ["clientName","reference","eventDate"]
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([slug, locale])
  @@index([slug])
  @@map("email_templates")
}

// ═══════════════════════════════════════════════════════════════════════════
// TRACKING D'EMAILS ENVIATS
// ═══════════════════════════════════════════════════════════════════════════

model EmailSend {
  id            String   @id @default(cuid())
  trackingToken String   @unique @default(cuid())
  templateKey   String? // 'primer-contacte', 'seguiment', etc.
  to            String
  subject       String
  htmlBody      String?  @db.Text  // Snapshot del HTML enviat (per a previsualització a l'admin)
  leadId        String?
  customerId    String?
  locale        String?
  sentAt        DateTime @default(now())
  openedAt      DateTime?
  openCount     Int      @default(0)
  clickedAt     DateTime?
  clickCount    Int      @default(0)

  // ── Observabilitat real del canal (no posa la BD al canal: només recull
  //    l'estat del que ha passat al servidor SMTP/IMAP). ────────────────────
  smtpAccepted   String[] @default([])
  smtpRejected   String[] @default([])
  smtpResponse   String?
  smtpMessageId  String?
  /// True: APPEND al folder Sent OK. False: APPEND ha fallat. Null: no intentat.
  imapAppendOk   Boolean?
  imapSentFolder String?
  imapSentUid    Int?
  imapError      String?
  /// Headers Òrbita (kind/id/origin) per a auditoria si el client respon.
  orbitaKind     String?
  orbitaId       String?
  orbitaOrigin   String?

  @@index([templateKey])
  @@index([leadId])
  @@index([sentAt])
  @@index([imapAppendOk])
  @@index([orbitaKind, orbitaId])
  @@map("email_sends")
}

// ═══════════════════════════════════════════════════════════════════════════
// COL·LABORADORS
// ═══════════════════════════════════════════════════════════════════════════

model Collaborator {
  id            String                   @id @default(cuid())
  name          String
  company       String?
  email         String?
  phone         String?
  specialty     String?                  // Especialitat (DJ, Presentador, Tècnic so...)
  roles         String[]                 @default([]) // PROVIDER, REFERRER, EQUIPMENT_RENTAL, CLIENT_PARTNER, CREW
  commissionPct Float                    @default(0)  // % comissió de vendes (0 si és treballador extern)
  pricingModel  CollaboratorPricingModel @default(DISCOUNT)
  costPerHour   Float?                   // Cost que ens cobra per hora (calculadora de costos)
  notes         String?                  @db.Text
  isActive      Boolean                  @default(true)
  isFavorite    Boolean                  @default(false) // Surt als desplegables ràpids de reserva (origen/facturació)

  bookings CollaboratorBooking[]
  products CollaboratorProduct[]
  members CollaboratorMember[]
  sourcedLeads Lead[] @relation("LeadSourceCollaborator")
  sourcedBookings Booking[] @relation("BookingSourceCollaborator")
  billedBookings Booking[] @relation("BookingBilledCollaborator")
  bookingServiceLines BookingServiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collaborators")
}

// Persones dins d'un proveïdor (p.ex. Masquerade → Carlos Lucas BOSS, Jonathan mag).
// El proveïdor és el Collaborator; els membres són les persones que hi treballen.
model CollaboratorMember {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  name      String
  role      String  @default("OTHER") // BOSS, MAGICIAN, ANIMATOR, DJ, TECH, OTHER
  phone     String?
  email     String?
  isActive  Boolean @default(true)
  notes     String? @db.Text
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collaboratorId])
  @@map("collaborator_members")
}

// Catàleg de productes/serveis que ofereix un col·laborador (revenda amb marge).
// costPrice = cost net que ens cobra el col·laborador; sellPrice = el nostre PVP.
model CollaboratorProduct {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  name          String
  description   String? @db.Text
  category      String? // "Animació infantil", "Musical", "Extra", "Bingo"...
  crew          String? // "Animador + tècnic de so"
  durationLabel String? // "1h", "70 min"
  costPrice     Float // Cost net que ens cobra el col·laborador (sense IVA)
  sellPrice     Float // El nostre PVP (cost + marge)
  imageUrl      String?
  includes      String? @db.Text // Què inclou el producte
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collaboratorId])
  @@map("collaborator_products")
}

model CollaboratorBooking {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  commissionPct     Float // % comissió aplicat
  commissionAmount  Float // Import comissió en €
  collaboratorPrice Float? // Preu que veu el col·laborador (si model DISCOUNT)
  isPaid            Boolean   @default(false)
  paidAt            DateTime?

  createdAt DateTime @default(now())

  @@unique([collaboratorId, bookingId])
  @@index([bookingId])
  @@index([collaboratorId])
  @@map("collaborator_bookings")
}

enum CollaboratorPricingModel {
  NET_PLUS_COMMISSION // Preu net: col·lab afegeix la seva comissió
  DISCOUNT // Descompte: col·lab rep preu amb X% menys
}

// ═══════════════════════════════════════════════════════════════════════════
// PRICING CONFIG (Configuració de pricing intelligence editable des d'admin)
// ═══════════════════════════════════════════════════════════════════════════

/// Singleton: una sola fila (id = "default").
/// Fallback canònic a lib/constants/pricing-intelligence.ts si la fila no existeix.
model PricingConfig {
  id                     String   @id @default("default")

  /// % de marge objectiu sobre preu NET (sense IVA)
  targetMarginPct        Float    @default(40)

  /// Tarifa €/h per tipus de servei. JSON: { fiesta_privada:{min,recommended,premium}, ... }
  ourHourlyRateByService Json     @default("{}")

  /// % senyal recomanat sobre el total
  depositPctRecommended  Float    @default(30)

  /// Llindars d'alerta. JSON: { priceDeviationAlertPct, priceDeviationCriticalPct, lowMarginPct, criticalMarginPct }
  alertThresholds        Json     @default("{}")

  /// Amortització equip per categoria (override del fallback). JSON: { SOUND:{value,lifeHours}, ... }
  equipmentAmortization  Json?

  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())

  @@map("pricing_config")
}

// ═══════════════════════════════════════════════════════════════════════════
// PRESSUPOSTOS PERSONALITZATS (Cost Calculator)
// ═══════════════════════════════════════════════════════════════════════════

model CustomQuote {
  id          String  @id @default(cuid())
  name        String // "DJ 3h sense altaveus - Client X"
  clientName  String?
  clientEmail String?

  // Components (JSON array)
  components Json // [{ type: "dj", hours: 3, unitCost: 25, total: 75 }, ...]

  // Totals
  totalCost      Float // Cost real total
  suggestedPrice Float // Preu suggerit (cost + marge)
  marginPct      Float // Marge aplicat
  finalPrice     Float? // Preu final (si es modifica manualment)

  // Estat
  status CustomQuoteStatus @default(DRAFT)
  sentAt DateTime?
  notes  String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("custom_quotes")
}

enum CustomQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════════
// GALERIA DE FOTOS D'EVENTS
// ═══════════════════════════════════════════════════════════════════════════

model BookingGalleryPhoto {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  photoUrl     String // URL de la foto (uploads/bookings/{id}/gallery/{timestamp}.webp)
  thumbnailUrl String? // URL thumbnail (opcional, generat)
  caption      String? // Descripció breu
  sortOrder    Int     @default(0)

  // Visibilitat
  isPortfolio   Boolean @default(false) // Mostrar al portfolio públic
  isPortal      Boolean @default(true) // Mostrar al portal client
  portfolioSlug String? // Carpeta del portfolio: "bodas", "discomovil", "fiestas-privadas", etc.

  uploadedBy String? // Admin que ha pujat
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([isPortfolio])
  @@index([portfolioSlug])
  @@map("booking_gallery_photos")
}

// ═══════════════════════════════════════════════════════════════════════════
// PORTFOLIO MEDIA (pujades directes, no lligades a booking)
// ═══════════════════════════════════════════════════════════════════════════

model PortfolioMedia {
  id           String          @id @default(cuid())
  slug         String // Categoria: "bodas", "discomovil", etc.
  mediaUrl     String // URL del fitxer
  thumbnailUrl String? // Thumbnail per vídeos
  caption      String?
  mediaType    String          @default("image") // "image" | "video"
  sortOrder    Int             @default(0)
  eventId      String? // Opcional: vinculat a un event concret
  event        PortfolioEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploadedBy   String?
  createdAt    DateTime        @default(now())

  @@index([slug])
  @@index([slug, sortOrder])
  @@index([eventId])
  @@map("portfolio_media")
}

// ═══════════════════════════════════════════════════════════════════════════
// PORTFOLIO EVENTS (mini-pàgines per event concret)
// ═══════════════════════════════════════════════════════════════════════════

model PortfolioEvent {
  id           String           @id @default(cuid())
  slug         String           @unique // URL: /portfolio/bodas/boda-laura-marc
  categorySlug String // "bodas", "discomovil", etc.
  title        String // "Boda Laura & Marc"
  subtitle     String? // "Masía Can Riera · Septiembre 2024"
  venue        String? // "Masía Can Riera"
  location     String? // "Girona"
  eventDate    DateTime?
  guestCount   Int?
  description  String? // Text lliure de l'event
  services     String[] // ["DJ", "Iluminación", "Tematización"]
  coverImage   String // URL de la imatge hero
  published    Boolean          @default(false)
  sortOrder    Int              @default(0)
  media        PortfolioMedia[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([categorySlug, published])
  @@index([published, sortOrder])
  @@map("portfolio_events")
}

model ImageAsset {
  id        String   @id @default(cuid())
  placement String
  src       String
  filePath  String?
  alt       String?
  label     String?
  mimeType  String?
  width     Int?
  height    Int?
  sizeBytes Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement])
  @@index([placement, sortOrder])
  @@map("image_assets")
}

// ═══════════════════════════════════════════════════════════════════════════
// SOCIAL MEDIA CALENDAR
// ═══════════════════════════════════════════════════════════════════════════

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  LINKEDIN
  X
  PINTEREST
  YOUTUBE
}

enum SocialPostStatus {
  IDEA
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SocialContentType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
  STORY
  TEXT
}

enum SocialCategory {
  EVENT_SHOWCASE
  BEHIND_SCENES
  TESTIMONIAL
  PROMO
  TIPS
  TEAM
  SEASONAL
  COLLAB
}

model SocialPost {
  id          String            @id @default(cuid())
  title       String
  caption     String?           @db.Text
  hashtags    String[]
  platforms   SocialPlatform[]
  status      SocialPostStatus  @default(IDEA)
  contentType SocialContentType @default(IMAGE)
  category    SocialCategory?

  // Planificació
  scheduledAt DateTime?
  publishedAt DateTime?

  // Media (URLs o paths)
  mediaUrls String[]

  // Relació opcional amb booking/event per contingut derivat
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  // Notes internes
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([category])
  @@index([bookingId])
  @@map("social_posts")
}
